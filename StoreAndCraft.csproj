<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>StoreAndCraft</AssemblyName>
    <RootNamespace>StoreAndCraft</RootNamespace>
    <Product>StoreAndCraft</Product>
    <Version>1.4.2</Version>
    <ModVersion>1.4.2</ModVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Unity\**" />
    <EmbeddedResource Remove="Unity\**" />
    <None Remove="Unity\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Content\UI\*.png" />
    <EmbeddedResource Remove="Content\UI\*_rim.png" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Carved display AssetBundle: copy Content/Displays/sac_displays into plugins/StoreAndCraft/displays. -->
    <IncludeDisplayBundle Condition="'$(IncludeDisplayBundle)' == ''">true</IncludeDisplayBundle>
  </PropertyGroup>

  <ItemGroup>
    <DisplayBundle Include="Content\Displays\sac_displays" Condition="'$(IncludeDisplayBundle)' == 'true' AND Exists('$(MSBuildThisFileDirectory)Content\Displays\sac_displays')" />
    <DisplayDefinition Include="Content\Displays\definitions\*.json" Condition="Exists('$(MSBuildThisFileDirectory)Content\Displays\definitions')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build">
    <PropertyGroup>
      <DeployDir>$(BepInExDir)\plugins\StoreAndCraft</DeployDir>
      <ThunderstorePackRoot>$(MSBuildThisFileDirectory)thunderstore\StoreAndCraft</ThunderstorePackRoot>
      <DesktopModPackDir>C:\Users\morda\Desktop\Valheim mods\StoreAndCraft</DesktopModPackDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(DisplayBundle)" DestinationFolder="$(DeployDir)\displays" OverwriteReadOnlyFiles="true" Condition="'@(DisplayBundle)' != ''" />
    <Copy SourceFiles="@(DisplayDefinition)" DestinationFolder="$(DeployDir)\displays\definitions" OverwriteReadOnlyFiles="true" Condition="'@(DisplayDefinition)' != ''" />
    <MakeDir Directories="$(ThunderstorePackRoot)\plugins\StoreAndCraft" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ThunderstorePackRoot)\plugins\StoreAndCraft" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(DisplayBundle)" DestinationFolder="$(ThunderstorePackRoot)\plugins\StoreAndCraft\displays" OverwriteReadOnlyFiles="true" Condition="'@(DisplayBundle)' != ''" />
    <Copy SourceFiles="@(DisplayDefinition)" DestinationFolder="$(ThunderstorePackRoot)\plugins\StoreAndCraft\displays\definitions" OverwriteReadOnlyFiles="true" Condition="'@(DisplayDefinition)' != ''" />
  </Target>
  <Target Name="PackThunderstore" AfterTargets="Deploy" Condition="'$(Configuration)' == 'Release' AND '$(Pack)' == 'true'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)thunderstore\packs" />
    <MakeDir Directories="$(DesktopModPackDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)pack-thunderstore.ps1&quot; -Version &quot;$(ModVersion)&quot; -PackRoot &quot;$(MSBuildThisFileDirectory)thunderstore\StoreAndCraft&quot; -OutputDir &quot;$(DesktopModPackDir)&quot; -PackageName &quot;StoreAndCraft&quot;" />
  </Target>
</Project>
